# Story engine (required for personalised stories). console.anthropic.com → API keys.
ANTHROPIC_API_KEY=
# Only if the key was created at organisation level (not inside a workspace):
# Console → Settings → Workspaces → copy the workspace ID (starts wrkspc_).
ANTHROPIC_WORKSPACE_ID=
# Optional overrides.
STORY_MODEL=claude-opus-5-5
STORY_EFFORT=low

# Asset pipeline only (scripts/, run locally — never needed by the deployed app).
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
NARRATOR_VOICE_ID=

# Family accounts (next phase).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
