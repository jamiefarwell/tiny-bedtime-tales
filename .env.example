# --- Story engine (personalised stories) -------------------------------------
# console.anthropic.com → API keys.
ANTHROPIC_API_KEY=
# Only if the key was created at organisation level (not inside a workspace):
# Console → Settings → Workspaces → copy the workspace ID (starts wrkspc_).
ANTHROPIC_WORKSPACE_ID=
STORY_MODEL=claude-opus-5-5
STORY_EFFORT=low

# --- Pictures starring the child (personalised stories) -----------------------
# aistudio.google.com → API keys. Also used by the asset pipeline (scripts/).
# Leave empty to switch pictures off.
GEMINI_API_KEY=

# --- Accounts, sync and token wallets (Supabase) -------------------------------
# Setting all three switches the app from preview mode to accounts + tokens.
# Supabase → Project settings → API keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- Payments (Stripe) — requires Supabase too --------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_FAMILY_MONTHLY=
STRIPE_PRICE_FAMILY_YEARLY=
STRIPE_PRICE_PACK_3=
STRIPE_PRICE_PACK_10=
# Public site address, used for Stripe and sign-in redirects.
NEXT_PUBLIC_SITE_URL=

# --- Asset pipeline only (scripts/, run locally) ------------------------------
ELEVENLABS_API_KEY=
NARRATOR_VOICE_ID=
